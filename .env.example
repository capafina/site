# Copy to .env.local and fill in once real accounts exist.
# Leave blank to keep all tracking switched off.

# Public site URL (used for canonical URLs, sitemap and schema)
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 (G-...)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads (AW-...) and conversion labels
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_FORM=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_PHONE=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_BOOKING=

# Call tracking (dynamic number insertion) script URL, if used
NEXT_PUBLIC_CALL_TRACKING_SCRIPT_URL=

# Enquiry form delivery (CRM / Zapier / Make / email-service webhook)
ENQUIRY_WEBHOOK_URL=
